<h1>02</h1>

<form action="/" method="POST">
    <p>Login:</p>
    <input type="text" name="login" />
    <p>Password:</p>
    <input type="text" name="pass" />
    <input type="submit" />
</form>

<table>
    <tr>
        <th>lp</th>
        <th>Login</th>
        <th>Password</th>
    </tr>
    {{#each docs}}
    <tr>
        <td>{{@index}}</td>
        <td>{{login}}</td>
        <td>{{pass}}</td>
    </tr>
    {{/each}}
</table>

<p>{{text}}</p>