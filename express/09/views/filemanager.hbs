<header>
  <h1>File manager</h1>
  <div class="path">
    {{path}}
  </div>
</header>

<div style="display: flex; flex-flow: row;">
    {{#if error}}
        {{> error}}
    {{else }}
        <aside>
            <button class="btn-new">New folder</button>
            <button class="btn-new">New file</button>
        </aside>

        <main>
            <div style="display: flex;">
                <h2>Folders</h2>
                {{#if hrefParentPath}}
                <a href="?path={{hrefParentPath}}">Back</a>
                {{/if}}
            </div>
            
            <section class="folders">
            {{#if folders}}
                {{#each folders}}
                <a class="folder" href="?path={{../hrefPath}}%2F{{name}}">{{name}}</a>
                {{/each}}
            {{else}}
                <p class="no-content">No folders</p>
            {{/if}}
            </section>
            <h2>Files</h2>
            <section class="files">
            {{#if files}}
                {{#each files}}
                <a class="file">{{name}}</a>
                {{/each}}
            {{else}}
                <p class="no-content">No files</p>
            {{/if}}
            </section>
        </main>
    {{/if}}

  
</div>