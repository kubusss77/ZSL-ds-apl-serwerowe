<h2>Add car</h2>
<form action="/add" method="POST">
    <div class="row">
        <p>Ubezpiezony</p>
        <input type="checkbox" name="ubez">
    </div>
    <div class="row">
        <p>Benzyna</p>
        <input type="checkbox" name="benz">
    </div>
    <div class="row">
        <p>Uszkodzony</p>
        <input type="checkbox" name="uszk">
    </div>
    <div class="row">
        <p>Napęd 4x4</p>
        <input type="checkbox" name="naped">
    </div>
    <input type="submit" value="Add">
</form>

<p class="info">{{text }}</p>