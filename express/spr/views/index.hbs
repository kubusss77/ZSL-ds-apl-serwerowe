{{#if filter}}
  <p><a href='/'>Wróć</a></p>
{{/if}}

<form method='GET' action='/filter'>
  {{#each categories}}
    {{this}}
    <input type='radio' name='category' value='{{this}}' required='required' />
  {{/each}}
  <br />
  Minimalna średnia ocen:
  <input type='number' min='1' max='5' name='avg' />
  <input type='submit' value='Filtruj' />
</form>

{{#if products}}
<table>
  <tr>
    <th>Tytuł</th>
    <th>Kategoria</th>
    <th>Obraz</th>
    <th>Średnia ocen</th>
    <th>Cena</th>
  </tr>
  {{#each products}}
    <tr>
      <td><a href='/{{index}}'>{{title}}</a></td>
      <td>{{category}}</td>
      <td><img src='{{img_url}}' class='img-small' /></td>
      <td>{{reviews}}</td>
      <td>{{price}} zł</td>
    </tr>
  {{/each}}
{{else}}
<p>Brak produktów</p>
{{/if}}
</table>