@baseUrl = http://localhost:3000/api


### All pphotos metadata
GET {{baseUrl}}/photos

### Single photo metadata
GET {{baseUrl}}/photos/1779436155908

### Delete photo
DELETE {{baseUrl}}/photos/1779436155908

### Update photo

PATCH {{baseUrl}}/photos/1779439360852
Content-Type: application/json

{
  "status": "new"
}

### Add tag to photo
PATCH {{baseUrl}}/photos/1781722761543/tags
Content-Type: application/json

{
  "tag": "new tag"
}

### Like photo
POST {{baseUrl}}/photos/1779439360852/like
Authorization: Bearer <token>
