@baseUrl = http://localhost:3000/api

### Register new user
POST {{baseUrl}}/user/register
Content-Type: application/json

{
  "name": "kuba",
  "lastName": "sz",
  "email": "email@example.com",
  "password": "2"
}

### Confirm user
GET {{baseUrl}}/user/confirm/<token>

### Login user
POST {{baseUrl}}/user/login
Content-Type: application/json

{
  "email": "email@example.com",
  "password": "2"
}

